# Normalize text to LF for consistent diffs across operating systems.
* text=auto eol=lf

# Source and configuration files.
*.cs text diff=csharp
*.shader text
*.compute text
*.cginc text
*.hlsl text
*.glsl text
*.asmdef text
*.asmref text
*.json text
*.xml text
*.yml text
*.yaml text
*.md text
*.uxml text
*.uss text

# Unity serialized assets: preserve readable YAML and auto-detect binary assets.
*.meta text
*.unity text
*.prefab text
*.asset text=auto
*.mat text
*.anim text
*.controller text
*.overrideController text
*.playable text
*.mask text
*.physicMaterial text
*.physicsMaterial2D text
*.renderTexture text
*.lighting text=auto
*.terrainlayer text
*.shadergraph text
*.shadersubgraph text
*.vfx text

# Windows command scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Track binary assets with Git LFS when they are added to Git.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
