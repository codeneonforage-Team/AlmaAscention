# Unity-generated directories (also applies to projects in subfolders).
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Bb]uild/
[Bb]uilds/
[Mm]emoryCaptures/
[Rr]ecordings/

# Keep Assets/, Packages/, ProjectSettings/, and their .meta files in Git.
# Only ignore metadata belonging to generated directories.
[Ll]ibrary.meta
[Tt]emp.meta
[Oo]bj.meta
[Ll]ogs.meta
[Uu]ser[Ss]ettings.meta
[Bb]uild.meta
[Bb]uilds.meta
[Mm]emoryCaptures.meta
[Rr]ecordings.meta

# IDE caches and Unity-generated solution/project files.
.vs/
.idea/
.gradle/
.consulo/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports and generated diagnostic output.
sysinfo.txt
*.stackdump

# Generated Addressables output; retain AddressableAssetsData configuration.
**/Assets/AddressableAssetsData/*/*.bin*
**/Assets/AddressableAssetsData/*/*.hash*
**/Assets/StreamingAssets/aa/
**/Assets/StreamingAssets/aa.meta

# Operating-system and editor temporary files.
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
